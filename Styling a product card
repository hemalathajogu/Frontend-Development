<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Product Card</title>
    <style>
        body {
            margin: 0;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(135deg, #eef2ff 0%, #f8fafc 100%);
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            color: #1f2937;
        }

        .product-card {
            width: 320px;
            background: #ffffff;
            border-radius: 24px;
            box-shadow: 0 24px 50px rgba(15, 23, 42, 0.12);
            overflow: hidden;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

        .product-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 30px 65px rgba(15, 23, 42, 0.18);
        }

        .product-image {
            width: 100%;
            display: block;
            object-fit: cover;
            height: 220px;
        }

        .product-details {
            padding: 24px;
        }

        .product-title {
            font-size: 1.4rem;
            margin-bottom: 8px;
            letter-spacing: -0.02em;
        }

        .product-price {
            font-size: 1.8rem;
            color: #2563eb;
            font-weight: 700;
            margin-bottom: 18px;
        }

        .product-description {
            font-size: 0.95rem;
            line-height: 1.7;
            color: #4b5563;
            margin-bottom: 24px;
        }

        .add-to-cart {
            width: 100%;
            padding: 14px 18px;
            border: none;
            border-radius: 14px;
            background-color: #2563eb;
            color: #ffffff;
            font-size: 1rem;
            font-weight: 600;
            cursor: pointer;
            transition: background-color 0.25s ease, transform 0.25s ease;
        }

        .add-to-cart:hover {
            background-color: #1d4ed8;
            transform: translateY(-1px);
        }

        .add-to-cart:active {
            transform: translateY(0);
        }
    </style>
</head>
<body>
    <article class="product-card">
        <img class="product-image" src="https://images.unsplash.com/photo-1513708924885-757ceb5220d1?auto=format&fit=crop&w=800&q=80" alt="Wireless headphones product">
        <div class="product-details">
            <h1 class="product-title">Aurora Wireless Headphones</h1>
            <p class="product-price">$129.00</p>
            <p class="product-description">Enjoy crisp sound, active noise cancellation, and up to 24 hours of battery life in a lightweight, premium design.</p>
            <button class="add-to-cart">Add to Cart</button>
        </div>
    </article>
</body>
</html>